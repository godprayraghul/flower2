NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# PostgreSQL; used when DEMO_MODE=false
DATABASE_URL=postgresql://petalora:petalora@localhost:5432/petalora?schema=public

# Razorpay. Keep PAYMENT_MODE=demo until test keys are configured.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Maps. The app uses OpenStreetMap + browser GPS without a key.
# Add Google keys to enable Google reverse geocoding/navigation enhancements.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Optional Supabase Realtime. Polling remains available without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional mail
EMAIL_SERVER=
EMAIL_FROM=Petalora <orders@petalora.example>

# Optional Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Compatibility placeholders requested in the original specification.
# This rebuild uses SESSION_SECRET and custom secure cookie sessions rather than NextAuth.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
